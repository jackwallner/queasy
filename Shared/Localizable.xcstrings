    "New, severe or one-sided spinning is worth a doctor's opinion rather than an app's." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New, severe or one-sided spinning is worth a doctor's opinion rather than an app's."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika sensasi berputar baru muncul, parah, atau hanya di satu sisi, sebaiknya konsultasikan ke dokter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初めての回転性のめまい、強いめまい、片側だけのめまいは、アプリではなく医師に相談してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bespreek nieuwe, ernstige of eenzijdige draaiduizeligheid met een arts."
