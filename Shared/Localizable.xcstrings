    },
    "A nudge at %@ to run a three-minute hold, the way the wristband trials spaced them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A nudge at %@ to run a three-minute hold, the way the wristband trials spaced them."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat pada %@ untuk menekan selama tiga menit, mengikuti jeda dalam uji coba gelang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストバンドの試験と同じ間隔で、3分間押さえるよう%@にお知らせします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om %@ krijg je een herinnering om drie minuten druk te houden, met dezelfde tussenpozen als in de onderzoeken naar polsbandjes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
