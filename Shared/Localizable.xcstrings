    "Bland carbs (toast, crackers) settle faster than grease." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bland carbs (toast, crackers) settle faster than grease."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karbohidrat tawar (roti panggang, biskuit) lebih cepat diterima perut daripada makanan berminyak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脂っこいものより、トーストやクラッカーなどのあっさりした炭水化物のほうが、早く胃が落ち着きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koolhydraatrijk eten met een milde smaak (toast, crackers) valt sneller goed dan vet eten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alimentos leves, como torradas e biscoitos, caem melhor no estômago do que alimentos gordurosos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Простая углеводная еда, например тосты или крекеры, легче переносится, чем жирная."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาหารจำพวกแป้งรสอ่อน เช่น ขนมปังปิ้งหรือแครกเกอร์ ย่อยสบายกว่าอาหารมัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồ ăn giàu tinh bột, ít gia vị (bánh mì nướng, bánh quy giòn) nhẹ bụng hơn đồ nhiều dầu mỡ."
