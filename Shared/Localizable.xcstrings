    "Press firmly with your thumb, or sit the stud of an acupressure band there." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press firmly with your thumb, or sit the stud of an acupressure band there."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan dengan mantap menggunakan ibu jari, atau letakkan tonjolan gelang akupresur di titik itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "親指でしっかり押すか、指圧バンドの突起をそこに当てます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk stevig met je duim, of plaats het knopje van een acupressuurbandje op die plek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione com firmeza usando o polegar ou posicione ali a saliência de uma pulseira de acupressão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С усилием надави большим пальцем или расположи на точке выступ акупрессурного браслета."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้นิ้วหัวแม่มือกดให้แน่น หรือวางปุ่มของสายรัดกดจุดตรงตำแหน่งนั้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng ngón cái ấn chắc, hoặc đặt nút của vòng bấm huyệt vào vị trí đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用拇指稳稳按压，或将穴位按压腕带的凸点放在此处。"
          }
        }
      }
    },
