    "Rehydrate slowly, small sips beat big gulps." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rehydrate slowly, small sips beat big gulps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minum perlahan, sedikit demi sedikit lebih baik daripada meneguk banyak sekaligus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度にたくさん飲まず、少しずつ水分を取ってみてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink langzaam: kleine slokjes zijn beter dan grote teugen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidrate-se devagar, em pequenos goles em vez de grandes quantidades de uma vez."
          }
