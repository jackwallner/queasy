    "Plain crackers before you sit up in the morning, if you can face them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plain crackers before you sit up in the morning, if you can face them."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba makan biskuit tawar sebelum duduk di pagi hari, jika kamu sanggup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食べられそうなら、朝起き上がる前にプレーンなクラッカーを試してみてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eet 's ochtends wat gewone crackers voordat je gaat zitten, als dat lukt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biscoitos simples antes mesmo de se sentar na cama pela manhã, se conseguir comê-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утром попробуй съесть простые крекеры, прежде чем сесть в постели, если сможешь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองกินแครกเกอร์รสจืดก่อนลุกนั่งในตอนเช้า หากพอกินไหว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu ăn được, hãy thử bánh quy nhạt trước khi ngồi dậy vào buổi sáng."
