    "Keep the volume low. It should sit under the noise around you, not over it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the volume low. It should sit under the noise around you, not over it."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga volume tetap rendah. Suaranya harus lebih pelan daripada suara di sekitarmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量は低く保ってください。周囲の音より小さく聞こえる程度にします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het volume laag. De toon hoort onder het omgevingsgeluid te blijven, niet erbovenuit te komen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o volume baixo. O som deve ficar abaixo dos ruídos ao seu redor, não acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держи громкость низкой. Звук должен быть тише окружающего шума, а не перекрывать его."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับเสียงให้เบา ควรเบากว่าเสียงรอบตัว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ âm lượng nhỏ, thấp hơn tiếng ồn xung quanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持低音量，让声音低于周围的环境噪声。"
          }
        }
      }
    },
