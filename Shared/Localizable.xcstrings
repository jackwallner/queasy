            "value" : "Buka sedikit jendela. Aliran udara sejuk membantu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窓を少し開けてみましょう。涼しい風が役立ちます。"
