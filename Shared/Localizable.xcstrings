    "The inside of the wrist, three finger-widths below the crease, between the two tendons. Press with your thumb, or line up the stud on a band you already own." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The inside of the wrist, three finger-widths below the crease, between the two tendons. Press with your thumb, or line up the stud on a band you already own."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di bagian dalam pergelangan tangan, tiga jari di bawah lipatan, di antara dua tendon. Tekan dengan ibu jari, atau pasang tonjolan gelang yang sudah kamu punya pada titik itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首の内側、しわから指3本分下にある2本の腱の間です。親指で押すか、手持ちのバンドの突起を合わせてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan de binnenkant van je pols, drie vingerbreedtes onder de polsplooi, tussen de twee pezen. Druk met je duim of plaats het knopje van een bandje dat je al hebt op die plek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na parte interna do pulso, três dedos abaixo da dobra, entre os dois tendões. Pressione com o polegar ou posicione a saliência de uma pulseira que você já tenha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На внутренней стороне запястья, на три пальца ниже складки, между двумя сухожилиями. Надави большим пальцем или расположи на точке выступ своего браслета."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ด้านในข้อมือ ห่างจากรอยพับลงมาสามนิ้วมือ ระหว่างเส้นเอ็นสองเส้น ใช้นิ้วหัวแม่มือกด หรือจัดตำแหน่งปุ่มของสายรัดที่มีอยู่แล้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở mặt trong cổ tay, cách nếp gấp ba bề ngang ngón tay, giữa hai gân. Dùng ngón cái ấn hoặc đặt nút của vòng bạn có sẵn vào đúng vị trí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手腕内侧，腕横纹下方约三指宽处，两条肌腱之间。用拇指按压，或将已有腕带的凸点对准该处。"
          }
        }
      }
    },
    "The same" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
