        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ненавязчивое напоминание поможет не забыть ненадолго нажать на точку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเตือนความจำเบาๆ ช่วยให้จำการกดค้างสั้นๆ ได้ง่ายขึ้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lời nhắc nhẹ nhàng giúp bạn nhớ dành chút thời gian ấn giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
