    "The spot is under the edge of your third finger, in the dip between the two tendons." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spot is under the edge of your third finger, in the dip between the two tendons."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titiknya berada di bawah tepi jari ketigamu, di lekukan antara dua tendon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツボは3本目の指の端の下、2本の腱の間のくぼみにあります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De plek zit onder de rand van je derde vinger, in het kuiltje tussen de twee pezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ponto fica sob a borda do terceiro dedo, na depressão entre os dois tendões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точка находится под краем третьего пальца, во впадине между двумя сухожилиями."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จุดนี้อยู่ใต้ขอบนิ้วที่สามของคุณ ในร่องระหว่างเส้นเอ็นสองเส้น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vị trí này nằm dưới mép ngón tay thứ ba, ở chỗ lõm giữa hai gân."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个位置在第三根手指的边缘下方，两条肌腱之间的凹陷处。"
          }
        }
      }
    },
