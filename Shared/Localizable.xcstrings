    "Out for longer than in, paced by your wrist." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Out for longer than in, paced by your wrist."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embuskan napas lebih lama daripada menariknya, ikuti irama di pergelangan tangan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首で一定のペースを感じながら、吸うときより長く息を吐きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem langer uit dan in, op het tempo dat je op je pols voelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expire por mais tempo do que inspira, acompanhando o ritmo no pulso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдыхай дольше, чем вдыхаешь, следуя ритму на запястье."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หายใจออกให้นานกว่าหายใจเข้า ตามจังหวะที่รู้สึกบนข้อมือ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thở ra lâu hơn hít vào, theo nhịp bạn cảm nhận trên cổ tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随手腕上的节奏呼吸，呼气比吸气更长。"
          }
        }
      }
    },
