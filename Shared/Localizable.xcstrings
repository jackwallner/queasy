        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงบริสุทธิ์ 100 Hz ที่ระดับเสียงเบา สวมหูฟังหนึ่งนาที มองไปทางไหนก็ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thuần 100 Hz ở âm lượng nhỏ. Đeo tai nghe, nghe một phút, nhìn đâu tùy bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低音量的 100 Hz 纯音。戴上耳机听一分钟，目光随意。"
          }
        }
      }
    },
    "A steady tap on the inside of your wrist" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A steady tap on the inside of your wrist"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketukan teratur di bagian dalam pergelangan tangan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首の内側で感じる、一定のリズムのタップ"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een regelmatige tik aan de binnenkant van je pols"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque constante na parte interna do pulso"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Равномерные постукивания на внутренней стороне запястья"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแตะสม่ำเสมอที่ข้อมือด้านใน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm nhận nhịp gõ đều ở mặt trong cổ tay"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感受手腕内侧规律的轻振"
          }
        }
      }
    },
    "A steady tap on your wrist. A paced breath you feel rather than watch. A one-minute 100 Hz tone. A timed hold on the spot an acupressure band sits on. All drug-free, all free to use." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A steady tap on your wrist. A paced breath you feel rather than watch. A one-minute 100 Hz tone. A timed hold on the spot an acupressure band sits on. All drug-free, all free to use."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketukan teratur di pergelangan tangan. Napas berirama yang kamu rasakan tanpa perlu melihat. Nada 100 Hz selama satu menit. Tekanan dengan timer pada titik tempat gelang akupresur dipasang. Semuanya bebas obat dan gratis digunakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首で感じる、一定のリズムのタップ。画面を見る代わりに、振動でペースを感じながら行う呼吸。1分間の100 Hzの音。指圧バンドを当てる場所を押さえる時間の計測。すべて薬を使わず、無料で試せます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een regelmatige tik op je pols. Een vast ademritme dat je voelt in plaats van op een scherm volgt. Een minuut lang een toon van 100 Hz. Met een timer druk houden op de plek waar een acupressuurbandje zit. Allemaal zonder medicijnen en gratis te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque constante no pulso. Uma respiração ritmada que você sente sem precisar olhar. Um tom de 100 Hz por um minuto. Uma pressão cronometrada no ponto onde fica uma pulseira de acupressão. Tudo sem medicamentos e grátis para usar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Равномерные постукивания на запястье. Дыхание в заданном ритме, которому можно следовать по ощущениям, не глядя на экран. Звук 100 Hz в течение минуты. Нажатие по таймеру на точку под акупрессурным браслетом. Всё без лекарств и бесплатно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแตะสม่ำเสมอบนข้อมือ การหายใจตามจังหวะที่คุณสัมผัสได้โดยไม่ต้องมอง เสียง 100 Hz หนึ่งนาที และการจับเวลากดค้างตรงตำแหน่งที่สายรัดกดจุดวางอยู่ ทั้งหมดไม่ใช้ยาและใช้งานได้ฟรี"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm nhận nhịp gõ đều trên cổ tay. Thở theo nhịp bạn cảm nhận thay vì nhìn. Nghe âm 100 Hz trong một phút. Ấn giữ có tính giờ tại vị trí đặt vòng bấm huyệt. Tất cả đều không dùng thuốc và miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感受手腕上规律的轻振。无需看屏幕，跟随触感按节奏呼吸。听一分钟 100 Hz 音调。在穴位按压腕带佩戴的位置持续按压并计时。全部无需用药，均可免费使用。"
          }
        }
      }
    },
    "A steady tap to rest your attention on." : {
