    "Long swell in, longer fade out. Rest the phone on you and shut your eyes if you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long swell in, longer fade out. Rest the phone on you and shut your eyes if you like."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasakan getaran naik perlahan, lalu memudar lebih lama. Tempelkan ponsel ke tubuh dan pejamkan mata jika mau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくり強まる振動に合わせて吸い、さらに長く弱まる振動に合わせて吐きます。よければiPhoneを体に当て、目を閉じてみてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een trilling die langzaam sterker wordt bij het inademen en nog langzamer afneemt bij het uitademen. Leg je telefoon tegen je aan en sluit je ogen als je wilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A intensidade aumenta aos poucos e diminui ainda mais devagar. Apoie o celular no corpo e, se quiser, feche os olhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вдохе сигнал долго нарастает, на выдохе ещё дольше затихает. Приложи телефон к телу и закрой глаза, если хочешь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หายใจเข้าตามจังหวะที่ค่อยๆ แรงขึ้น แล้วหายใจออกตามจังหวะที่ค่อยๆ เบาลงนานกว่า วางโทรศัพท์แนบตัวและหลับตาได้ตามต้องการ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hít vào theo nhịp rung mạnh dần, thở ra lâu hơn theo nhịp rung dịu dần. Đặt điện thoại lên người và nhắm mắt nếu muốn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随逐渐增强的振动吸气，再跟随更长的渐弱振动呼气。将手机贴在身上，也可以闭上眼睛。"
          }
        }
      }
    },
    "Long tap in, longer fade out. Eyes can stay shut." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long tap in, longer fade out. Eyes can stay shut."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketukan panjang saat menarik napas, lalu memudar lebih lama saat mengembuskan napas. Kamu bisa tetap memejamkan mata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長く続くタップに合わせて吸い、さらに長く弱まる振動に合わせて吐きます。目を閉じたままでも大丈夫です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een lange tik bij het inademen, die tijdens het langere uitademen langzaam wegzakt. Je kunt je ogen dicht houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um toque longo para inspirar, que diminui ainda mais devagar ao expirar. Você pode manter os olhos fechados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На вдохе сигнал долго нарастает, на выдохе ещё дольше затихает. Можешь закрыть глаза."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หายใจเข้าตามจังหวะแตะยาว แล้วหายใจออกตามจังหวะที่ค่อยๆ เบาลงนานกว่า หลับตาได้ตามสบาย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hít vào theo nhịp gõ dài, thở ra theo nhịp dịu dần lâu hơn. Bạn có thể nhắm mắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随较长的轻振吸气，再跟随更长的渐弱节奏呼气。可以闭着眼睛。"
          }
        }
      }
    },
    "Look at the horizon or a stable point far away." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at the horizon or a stable point far away."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pandang cakrawala atau titik yang diam di kejauhan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地平線や遠くの動かない一点を見つめてみてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk naar de horizon of een stilstaand punt in de verte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olhe para o horizonte ou para um ponto fixo ao longe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри на горизонт или на неподвижную точку вдали."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มองเส้นขอบฟ้าหรือจุดที่อยู่นิ่งในระยะไกล"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhìn về đường chân trời hoặc một điểm cố định ở xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看着地平线或远处固定的一点。"
          }
        }
      }
    },
