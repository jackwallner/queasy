    "Hold your iPhone against the inside of your wrist, or rest it where you can feel the taps." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold your iPhone against the inside of your wrist, or rest it where you can feel the taps."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempelkan iPhone ke bagian dalam pergelangan tangan, atau letakkan di tempat kamu bisa merasakan ketukannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneを手首の内側に当てるか、タップを感じられる場所に置いてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je iPhone tegen de binnenkant van je pols of leg hem ergens waar je de tikken kunt voelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
