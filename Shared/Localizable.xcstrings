        }
      }
    },
    "Thumb on the spot, three fingers below the crease." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thumb on the spot, three fingers below the crease."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan ibu jari di titik itu, tiga jari di bawah lipatan pergelangan tangan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首のしわから指3本分下のツボに親指を当てます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duim op de plek, drie vingers onder de polsplooi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polegar no ponto, três dedos abaixo da dobra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложи большой палец к точке на три пальца ниже складки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางนิ้วหัวแม่มือบนจุด ห่างจากรอยพับลงมาเท่าความกว้างของนิ้วมือสามนิ้ว"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ngón cái vào vị trí cách nếp gấp cổ tay ba bề ngang ngón tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将拇指放在腕横纹下方三指宽处。"
          }
        }
      }
    },
    "Thumb or band on the spot, steady pressure, three finger-widths below the wrist crease." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thumb or band on the spot, steady pressure, three finger-widths below the wrist crease."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan ibu jari atau gelang di titik itu, tiga jari di bawah lipatan pergelangan tangan, lalu berikan tekanan stabil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首のしわから指3本分下のツボに親指かバンドを当て、一定の力で押します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duim of band op de plek, gelijkmatige druk, drie vingerbreedtes onder de polsplooi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o polegar ou a pulseira no ponto, três dedos abaixo da dobra do pulso, e mantenha a pressão constante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Равномерно надавливай большим пальцем или браслетом на точку на три пальца ниже складки запястья."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางนิ้วหัวแม่มือหรือสายรัดบนจุด ห่างจากรอยพับข้อมือลงมาเท่าความกว้างของนิ้วมือสามนิ้ว แล้วกดค้างด้วยแรงสม่ำเสมอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ngón cái hoặc vòng vào vị trí cách nếp gấp cổ tay ba bề ngang ngón tay, rồi giữ lực ấn ổn định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在腕横纹下方三指宽处，用拇指或腕带持续按压。"
          }
        }
      }
    },
