    "Not feeling anything on your wrist? Open Queasy on your Apple Watch once to finish installing and start the wrist session." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not feeling anything on your wrist? Open Queasy on your Apple Watch once to finish installing and start the wrist session."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak merasakan apa pun di pergelangan tangan? Buka Queasy sekali di Apple Watch untuk menyelesaikan pemasangan dan memulai sesi di pergelangan tangan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首に何も感じませんか？Apple WatchでQueasyを一度開いてインストールを完了し、手首でのセッションを始めてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel je niets op je pols? Open Queasy één keer op je Apple Watch om de installatie af te ronden en de sessie op je pols te starten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não sente nada no pulso? Abra o Queasy no Apple Watch uma vez para concluir a instalação e iniciar a sessão no pulso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не чувствуешь ничего на запястье? Открой Queasy на Apple Watch, чтобы завершить установку и начать сеанс на запястье."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่รู้สึกอะไรที่ข้อมือใช่ไหม เปิด Queasy บน Apple Watch หนึ่งครั้งเพื่อติดตั้งให้เสร็จและเริ่มเซสชันบนข้อมือ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không cảm thấy gì ở cổ tay? Hãy mở Queasy trên Apple Watch một lần để hoàn tất cài đặt và bắt đầu phiên trên cổ tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手腕上没有感觉？在 Apple Watch 上打开一次 Queasy，完成安装并开始手腕练习。"
          }
        }
      }
    },
