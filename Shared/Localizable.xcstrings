    "No purchases found to restore." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No purchases found to restore."
          }
        },
        "id" : {
          "stringUnit" : {
