    },
    "If you cannot keep fluids down for a day, are losing weight, or feel faint, call your midwife or doctor. Sickness in pregnancy can get serious and there is treatment for it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you cannot keep fluids down for a day, are losing weight, or feel faint, call your midwife or doctor. Sickness in pregnancy can get serious and there is treatment for it."
          }
        }
      }
    },
    "If you're a passenger, face forward and sit up front if you can." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're a passenger, face forward and sit up front if you can."
          }
        }
