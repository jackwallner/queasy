    "Lay three fingers of the other hand across the wrist, just below the crease." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay three fingers of the other hand across the wrist, just below the crease."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letakkan tiga jari tangan lainnya melintang di pergelangan tangan, tepat di bawah lipatannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反対の手の指3本を、手首のしわのすぐ下に横向きに置きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg drie vingers van je andere hand dwars over je pols, net onder de polsplooi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque três dedos da outra mão sobre o pulso, logo abaixo da dobra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложи три пальца другой руки поперёк запястья, чуть ниже складки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางสามนิ้วของมืออีกข้างพาดบนข้อมือ ใต้รอยพับเล็กน้อย"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ba ngón tay của bàn tay kia ngang cổ tay, ngay dưới nếp gấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将另一只手的三根手指横放在手腕上，紧贴腕横纹下方。"
