        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse và Breathe chạy tối đa %#@n@ thay vì các phiên %#@m@, và tiếp tục chạy trên cổ tay khi màn hình tắt."
          },
          "substitutions" : {
