        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse 和 Breathe 的练习最长可达 %#@n@，不再限于 %#@m@，熄屏后仍可在手腕上继续。"
          },
          "substitutions" : {
            "n" : {
